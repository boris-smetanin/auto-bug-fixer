# Copy to .env and fill in.
# Loaded automatically by `docker compose up`.

# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port the Hono API server listens on AND the host port published by
# docker compose. Both sides of `-p HOST:CONTAINER` use this value.
PORT=3000

# Port the Vite dev server listens on (dev compose only). Browser opens here.
WEB_PORT=5173

# Port for the sqlite-web read-only DB browser (dev compose only).
SQLITE_WEB_PORT=8081

# Optional overrides (defaults shown):
# DATA_DIR=/data
# CORS_ORIGIN=*
