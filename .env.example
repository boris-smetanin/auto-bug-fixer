# Copy to .env and fill in.
# Loaded automatically by `docker compose up`.

# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port the server listens on AND the host port published by docker compose.
# Both sides of `-p HOST:CONTAINER` use this value.
PORT=3000

# Optional overrides (defaults shown):
# DATA_DIR=/data
# CORS_ORIGIN=*
